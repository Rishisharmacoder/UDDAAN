# ==========================================================
# APIx Platform Environment Configuration Template
# ==========================================================

# 1. Database Configuration (Connecting to your Docker container)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5435/UDAAN

DB_HOST=localhost
DB_PORT=5435
DB_NAME=UDAAN
DB_USER=postgres
DB_PASSWORD=postgres123

# 2. Amadeus GDS Official API Credentials (Optional)
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENVIRONMENT=test

# 3. Redis Hot Cache & Task Queue
REDIS_URL=redis://localhost:6379/0

# 4. App & API Server Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATA_SOURCE_DEFAULT=seed
